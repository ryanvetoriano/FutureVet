{
  "ConnectionStrings": {
    "OracleConnection": "User Id=SEU_USUARIO;Password=SUA_SENHA;Data Source=oracle.fiap.com.br:1521/ORCL"
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] CorrelationId={CorrelationId} {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },

  "OpenTelemetry": {
    "//OtlpEndpoint": "Opcional. Defina (ex.: http://localhost:4317) para exportar traces e metricas via OTLP. Vazio = exportador de console em Development.",
    "OtlpEndpoint": ""
  },

  "HealthChecks": {
    "//ExternalServices": "Dependencias HTTP externas monitoradas em /health/ready. A FutureVet nao consome APIs de terceiros no momento; adicione entradas {Name, Url, TimeoutSeconds, Optional} conforme necessario. Nunca inclua credenciais na Url.",
    "ExternalServices": []
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}
